# Claude API key (console.anthropic.com). ANTHROPIC_WORKSPACE_ID is only needed if your key isn't scoped to a workspace.
ANTHROPIC_WORKSPACE_ID=
ANTHROPIC_API_KEY=

# Dashboard
AGENCY_HOST=127.0.0.1               # 127.0.0.1 = this machine only; 0.0.0.0 = reachable from the local network
AGENCY_DASHBOARD_PASSWORD=          # set one to stop others on the network from pressing buttons

# Scouting
AGENCY_SOURCES=remoteok,weworkremotely,hackernews,greenhouse,ashby,reddit
AGENCY_SCOUT_MINUTES=30             # feeds are checked this often
AGENCY_BOARDS_HOURS=6               # company boards in boards.txt are swept this often
AGENCY_MAX_AGE_DAYS=21              # ignore postings older than this

# Claude agents
AGENCY_QUALIFIER_MODEL=claude-haiku-5-5
AGENCY_WRITER_MODEL=claude-opus-5-5
AGENCY_BUILDER_MODEL=claude-opus-5-5
AGENCY_DAILY_BUDGET=2.00            # USD per day, all agents together
AGENCY_MIN_FIT=70                   # qualifier score needed to shortlist a gig
AGENCY_PROPOSALS_PER_CYCLE=3
AGENCY_DEMOS_PER_DAY=2

# Reddit (optional): create a "script" app at https://www.reddit.com/prefs/apps
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_SUBREDDITS=forhire,freelance_forhire,slavelabour
